# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string
DATABASE_URL="mysql://user:password@localhost:3306/abaarso"

# Cloudinary (image/CV uploads)
CLOUD_NAME=""
API_KEY=""
API_SECRET=""

# JWT signing secret — required, no default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET_KEY=""

# Comma-separated list of origins allowed to call the public /api/public/* endpoints
# from a browser (the university website). Leave unset to allow any origin for
# read-only public endpoints.
# PUBLIC_SITE_ORIGINS="https://abaarsotechuniversity.org,http://localhost:3001"
